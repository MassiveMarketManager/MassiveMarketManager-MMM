# Copy to .env next to compose.yaml and fill in real values.
# compose.yaml reads these; anything left unset falls back to the
# defaults in application.properties, which are NOT usable in production.

# ---- Postgres ----
POSTGRES_USER=mmm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mmm
POSTGRES_PORT=5432

# ---- Vault ----
VAULT_TOKEN=root
VAULT_PORT=8200
# base64-encoded master key, required by the vault-seed service
APP_MASTER_KEY_B64=

# ---- App ----
APP_PORT=9000
TZ=UTC
# base64url-encoded, at least 32 bytes
JWT_SECRET=

# ---- Mailgun SMTP ----
# Get these from Mailgun: Sending -> Domain settings -> SMTP credentials.
# Leaving SPRING_MAIL_PASSWORD unset makes Mailgun reject login with
# "535 Authentication failed" on every sign-up.
SPRING_MAIL_HOST=smtp.eu.mailgun.org
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Base URL used to build the verification link inside the email.
# Must be the public site, not localhost, or the link in the email is dead.
APP_FRONTEND_BASE_URL=https://massivemarketmanager.de
